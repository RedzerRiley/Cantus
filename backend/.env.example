# Copy to backend/.env and adjust. All values are optional in local dev
# except that DJANGO_SECRET_KEY is REQUIRED whenever DJANGO_DEBUG is false.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Default (unset) is SQLite at backend/db.sqlite3.
# DATABASE_URL=sqlite:///db.sqlite3
# Postgres example:
# DATABASE_URL=postgres://cantus:cantus@localhost:5432/cantus

# Comma-separated lists of full origins (scheme://host[:port]).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Uploaded song files (PDF/PNG/JPEG/TXT/ChordPro).
# MEDIA_ROOT=/absolute/path/to/media      # default: backend/media
MAX_UPLOAD_MB=10

# Storage backend for uploads (STORAGES["default"]["BACKEND"]).
# Default: django.core.files.storage.FileSystemStorage
# To use S3: pip install django-storages[s3] boto3, then set
#   DJANGO_FILE_STORAGE=storages.backends.s3.S3Storage
# plus AWS_STORAGE_BUCKET_NAME / AWS_S3_REGION_NAME / credentials env vars
# (read by django-storages). Keep the bucket PRIVATE: files are streamed
# through the authenticated API endpoint.
# DJANGO_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# Production behind a TLS-terminating proxy:
# DJANGO_SECURE_PROXY_SSL_HEADER=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
